{
  "name": "@orbit/sdk",
  "version": "0.2.0-rc.3",
  "description": "Unit conversion (length, mass and temperature) for TypeScript and JavaScript.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LorenzoWynberg/orbit.git",
    "directory": "packages/sdk"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "http://localhost:4873",
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit",
    "pack:check": "node scripts/pack-check.mjs"
  },
  "devDependencies": {
    "@orbit/core": "workspace:*",
    "tsup": "^9.0.0"
  },
  "trinity": {
    "role": "package",
    "targets": [
      {
        "type": "Library",
        "label": "npm"
      }
    ],
    "embeds": [
      "packages/core"
    ]
  }
}
