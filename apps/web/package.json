{
  "name": "@orbit/web",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "web": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:extension": "vite build --mode extension",
    "zip:extension": "node scripts/zip-extension.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@orbit/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "fflate": "^0.8.3",
    "vite": "^8.3.8"
  },
  "trinity": {
    "role": "package",
    "targets": [
      {
        "type": "Web App",
        "label": "GitHub Pages"
      },
      {
        "type": "Extension",
        "label": "Chrome Web Store",
        "review": true
      }
    ],
    "embeds": [
      "packages/core"
    ]
  }
}
