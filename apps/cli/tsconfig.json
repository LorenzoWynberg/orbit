{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@orbit/sdk": ["../../packages/sdk/src/index.ts"],
      "@orbit/core": ["../../packages/core/src/index.ts"]
    }
  },
  "include": [
    "src",
    "package.json",
    "tsup.config.ts",
    "../../packages/sdk/src",
    "../../packages/core/src"
  ],
  "exclude": [
    "../../packages/sdk/src/**/*.test.ts",
    "../../packages/core/src/**/*.test.ts"
  ]
}
